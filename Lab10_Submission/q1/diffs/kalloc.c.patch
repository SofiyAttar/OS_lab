+// Assignment 10 Q1: Retrieve physical memory statistics.
+void
+getmemstats(uint *allocated, uint *freed, uint *available)
+{
+  struct run *r;
+  uint count = 0;
+
+  acquire(&kmem.lock);
+
+  *allocated = kmem.total_allocated;
+  *freed = kmem.total_freed;
+
+  // Count the pages currently present in the free list.
+  for(r = kmem.freelist; r; r = r->next)
+    count++;
+
+  *available = count;
+
+  release(&kmem.lock);
+}
