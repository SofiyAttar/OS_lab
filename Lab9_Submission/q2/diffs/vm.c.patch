+// Assignment 9 Q2: Allocate and map a lazy page.
+int
+alloclazy(pde_t *pgdir, uint va)
+{
+  char *mem;
+
+  mem = kalloc();
+  if(mem == 0)
+    return -1;
+
+  memset(mem, 0, PGSIZE);
+
+  if(mappages(pgdir, (char*)PGROUNDDOWN(va),
+              PGSIZE, V2P(mem), PTE_W | PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
 
+  return 0;
+}
